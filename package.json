{
  "name": "caskkeeper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:sync-indexes": "npx tsx scripts/sync-indexes.ts",
    "seed:whiskeys": "npx tsx scripts/import-whiskeys.ts",
    "seed:whiskeys:dry": "npx tsx scripts/import-whiskeys.ts --dry-run",
    "seed:whiskeys:insert": "npx tsx scripts/import-whiskeys.ts --insert-only",
    "seed:whiskeys:logged": "cross-env IMPORT_LOG_FILE=logs/import.log npx tsx scripts/import-whiskeys.ts",
    "seed:whiskeys:url": "npx tsx scripts/import-whiskeys.ts --url=https://example.com/whiskeys.json",
    "seed:whiskeys:file": "npx tsx scripts/import-whiskeys.ts --file=scripts/sample-data.json",
    "seed:debug": "cross-env DEBUG=true npx tsx scripts/import-whiskeys.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.368.0",
    "mongoose": "^8.3.0",
    "next": "14.2.1",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.51.3",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
