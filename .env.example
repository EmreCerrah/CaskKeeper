# =============================================================================
# CaskKeeper — ortam değişkenleri
# =============================================================================
# Yerel geliştirme:  bu dosyayı .env.local olarak kopyalayın
# Docker Compose:    yalnızca JWT_SECRET'ı .env dosyasına koyun
#                    (MONGODB_URI'yi compose kendisi verir)
# Vercel:            ikisini de Project Settings → Environment Variables'a girin
# =============================================================================

# MongoDB bağlantı adresi
#
#   Yerel:          mongodb://localhost:27017/caskkeeper
#   MongoDB Atlas:  mongodb+srv://<kullanici>:<parola>@<cluster>.mongodb.net/caskkeeper?retryWrites=true&w=majority
#
# Atlas kullanırken veritabanı adını (/caskkeeper) yolda belirtmeyi unutmayın —
# aksi halde Mongoose "test" veritabanına bağlanır.
MONGODB_URI=mongodb://localhost:27017/caskkeeper

# Oturum token'larını imzalayan anahtar (HS256).
#
# ÜRETİMDE MUTLAKA yeni ve rastgele bir değer üretin:
#   openssl rand -base64 48
#
# Bu anahtar değişirse tüm mevcut oturumlar geçersiz olur (kullanıcılar
# yeniden giriş yapar). Ortamlar arasında paylaşmayın.
JWT_SECRET=degistirin-guclu-bir-anahtar-kullanin
