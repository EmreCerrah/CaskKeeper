# MongoDB bağlantı adresi
# Yerel geliştirme: mongodb://localhost:27017/caskkeeper
# Docker Compose: app servisi için otomatik olarak mongodb://mongo:27017/caskkeeper kullanılır
MONGODB_URI=mongodb://localhost:27017/caskkeeper

# JWT imzalama anahtarı — üretimde güçlü ve benzersiz olmalı
# Üretmek için: openssl rand -base64 48
JWT_SECRET=degistirin-guclu-bir-anahtar-kullanin
